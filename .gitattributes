# 自动识别文本，仓库内规范化换行，不转换文本编码或 UTF-8 BOM。
* text=auto

# 源码、配置与文档采用 LF；Windows 脚本和解决方案检出为 CRLF。
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.sln text eol=crlf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 位图、图标与压缩文件保持二进制。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tif binary
*.tiff binary
*.zip binary
*.exe binary
*.dll binary
*.pdb binary

# oracle 输入包含 CRLF/LF 与末尾换行用例，保留原始字节，不做换行规范化。
tests/oracle/*.txt -text -eol
